Name jq's WIN32 entry body `main` instead of `umain` (mingw).

On WIN32 upstream calls the program body `umain`: `wmain` widens argv to
UTF-8 and hands off to it, and -municode keeps `wmain` the real entry.
Nothing is then named `main`, which is the symbol an applet entry of the
engine's multicall binds to, so the mingw link has no entry to wire.
Renaming the body restores that name and changes no behaviour: `wmain`
still runs first and still does the conversion. A rename upstream makes
this patch fail to apply instead of silently doing nothing.

--- a/src/main.c
+++ b/src/main.c
@@ -269,7 +269,7 @@
 }
 
 #ifdef WIN32
-int umain(int argc, char* argv[]);
+int main(int argc, char* argv[]);
 
 int wmain(int argc, wchar_t* wargv[]) {
   size_t arg_sz;
@@ -281,10 +281,10 @@
                                                    -1, 0, 0, 0, 0)));
     WideCharToMultiByte(CP_UTF8, 0, wargv[i], -1, argv[i], arg_sz, 0, 0);
   }
-  return umain(argc, argv);
+  return main(argc, argv);
 }
 
-int umain(int argc, char* argv[]) {
+int main(int argc, char* argv[]) {
 #else /*}*/
 int main(int argc, char* argv[]) {
 #endif
